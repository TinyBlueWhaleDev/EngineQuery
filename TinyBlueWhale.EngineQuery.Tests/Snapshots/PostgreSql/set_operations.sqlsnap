SELECT "u"."email" AS "Email"
FROM "users" AS "u"
WHERE ("u"."user_id" > @p0)
UNION ALL
SELECT "a"."email" AS "Email"
FROM "archived_users" AS "a"
WHERE ("a"."archived_user_id" > @p1)
INTERSECT
SELECT "a2"."email" AS "Email"
FROM "archived_users" AS "a2"
WHERE ("a2"."archived_user_id" > @p2)
EXCEPT
SELECT "a3"."email" AS "Email"
FROM "archived_users" AS "a3"
WHERE ("a3"."archived_user_id" > @p3)

-- Parameters
@p0 = 10
@p1 = 100
@p2 = 200
@p3 = 500